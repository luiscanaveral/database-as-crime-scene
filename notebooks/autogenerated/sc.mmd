erDiagram

  publicevents {
    uuid id PK
    int4 user_id
    varchar event_type
    timestamp created_at
  }

  publiclogs {
    serial id PK
    varchar session_id
    text message
    timestamp timestamp
  }

  publicmetrics {
    serial id PK
    varchar metric_name
    float8 value
    timestamp recorded_at
  }

  publicusers_profile {
    bigserial id PK
    text email UK
    text name
    timestamptz created_at
  }

  publicfriends {
    int8 user_id PK
    int8 friend_id PK
    timestamptz created_at
  }

  publicposts {
    bigserial id PK
    int8 fk_user_id FK
    text content
    timestamptz created_at
  }

  publiccomments {
    bigserial id PK
    int8 fk_user_id FK
    int8 fk_post_id FK
    text content
    timestamptz created_at
  }

